{
  "inputs": [
    {
      "type": "promptString",
      "id": "tarefas-token",
      "description": "Token do sistema de tarefas (o campo \"token\" de POST /auth/login)",
      "password": true
    }
  ],
  "servers": {
    "tarefas": {
      "type": "http",
      "url": "http://localhost:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${input:tarefas-token}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}

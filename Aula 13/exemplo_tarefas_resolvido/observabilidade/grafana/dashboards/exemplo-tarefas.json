{
  "uid": "exemplo-tarefas",
  "title": "Exemplo Tarefas: visão geral",
  "tags": [
    "aula13"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisições por segundo (por rota)",
      "description": "Tráfego: quantas requisições a API recebe, por rota.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"exemplo-tarefas\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência p95 (por rota)",
      "description": "95% das requisições respondem em até este tempo.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"exemplo-tarefas\",uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Erros por segundo (4xx e 5xx)",
      "description": "Erros: 4xx = o cliente errou; 5xx/502/504 = nós ou quem chamamos falhou.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"exemplo-tarefas\",status=~\"4..|5..\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Chamadas ao Open-Meteo (por resultado)",
      "description": "Dependência externa: quantas chamadas ao Open-Meteo deram certo ou erro.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (resultado) (rate(openmeteo_chamadas_seconds_count{application=\"exemplo-tarefas\"}[1m]))",
          "legendFormat": "{{resultado}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache da previsão: hit x miss",
      "description": "Quantas consultas foram atendidas pelo cache (hit) e quantas foram ao Open-Meteo (miss), em 5 min.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (resultado) (increase(previsao_cache_total{application=\"exemplo-tarefas\"}[5m]))",
          "legendFormat": "{{resultado}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RabbitMQ: eventos publicados x consumidos",
      "description": "Se 'publicado' sobe e 'consumido' não acompanha, a fila está acumulando.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tipo) (rate(tarefas_eventos_publicados_total{application=\"exemplo-tarefas\"}[1m]))",
          "legendFormat": "publicado {{tipo}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tipo) (rate(tarefas_eventos_consumidos_total{application=\"exemplo-tarefas\"}[1m]))",
          "legendFormat": "consumido {{tipo}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Memória heap da JVM",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"exemplo-tarefas\",area=\"heap\"})",
          "legendFormat": "usada",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{application=\"exemplo-tarefas\",area=\"heap\"})",
          "legendFormat": "máxima",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Conexões do pool do banco (Hikari)",
      "description": "Se 'ativas' encosta no máximo, as requisições começam a esperar por conexão.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{application=\"exemplo-tarefas\"}",
          "legendFormat": "ativas",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_max{application=\"exemplo-tarefas\"}",
          "legendFormat": "máximo",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Operações de tarefa (negócio)",
      "description": "Quantas vezes cada operação de tarefa deu certo: criar, atualizar, concluir, reabrir, remover, vincular...",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (operacao) (rate(tarefas_operacoes_total{application=\"exemplo-tarefas\"}[1m]))",
          "legendFormat": "{{operacao}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Erros por rota (4xx e 5xx)",
      "description": "Qual rota está errando, e com qual status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"exemplo-tarefas\",status=~\"4..|5..\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Todas as rotas da API (últimos 15 min)",
      "description": "Uma linha por método + rota: total de requisições, p95 e erros. Toda rota nova aparece aqui sozinha.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requisições",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "sum by (method, uri) (increase(http_server_requests_seconds_count{application=\"exemplo-tarefas\",uri!~\"/actuator.*\"}[$__range]))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"exemplo-tarefas\",uri!~\"/actuator.*\"}[$__range])))"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "instant": true,
          "format": "table",
          "expr": "sum by (method, uri) (increase(http_server_requests_seconds_count{application=\"exemplo-tarefas\",status=~\"4..|5..\",uri!~\"/actuator.*\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "method": "Método",
              "uri": "Rota",
              "Value #A": "Requisições",
              "Value #B": "p95 (s)",
              "Value #C": "Erros"
            }
          }
        }
      ]
    }
  ]
}
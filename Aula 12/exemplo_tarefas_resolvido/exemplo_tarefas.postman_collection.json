          "// {{data}} = hoje + 3 dias, no formato yyyy-MM-dd (dentro da janela de previsão).",
          "const d = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
          "const doisDigitos = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('data', `${d.getFullYear()}-${doisDigitos(d.getMonth() + 1)}-${doisDigitos(d.getDate())}`);"
        ]
